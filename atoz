public class Main {
    public static boolean containsAllAZ(String s) {
        boolean[] seen = new boolean[26];

        s = s.toLowerCase();

        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);

            if (ch >= 'a' && ch <= 'z') {
                seen[ch - 'a'] = true;
            }
        }

        for (int i = 0; i < 26; i++) {
            if (!seen[i]) {
                return false;
            }
        }

        return true;
    }

    public static void main(String[] args) {
        String s = "The quick brown fox jumps over a lazy dog";

        if (containsAllAZ(s)) {
            System.out.println("Contains all letters a-z");
        } else {
            System.out.println("Does not contain all letters a-z");
        }
    }
}
