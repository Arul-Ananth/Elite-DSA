public class Main {
    public static boolean canFormPalindrome(String s) {
        int[] freq = new int[26];

        s = s.toLowerCase();

        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);

            if (ch >= 'a' && ch <= 'z') {
                freq[ch - 'a']++;
            }
        }

        int oddCount = 0;

        for (int i = 0; i < 26; i++) {
            if (freq[i] % 2 != 0) {
                oddCount++;
            }
        }

        return oddCount <= 1;
    }

    public static void main(String[] args) {
        String s = "carrace";

        if (canFormPalindrome(s)) {
            System.out.println("Can form palindrome");
        } else {
            System.out.println("Cannot form palindrome");
        }
    }
}
